# Copy this file to .env next to docker-compose.yml and fill in real values.
# Never commit the real .env file.

# ---- App image (built and pushed to Docker Hub by the GitHub Actions workflow) ----
APP_IMAGE=yourdockerhubuser/alwakeel:latest

# ---- PostgreSQL (data lives in the db-data docker volume on this machine) ----
# Use letters/numbers only in the password (it is embedded in a connection URL).
POSTGRES_USER=alwakeel
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=construction

# ---- Public URL (Tailscale Funnel). The start script fills this in automatically. ----
# It looks like: https://your-machine.your-tailnet.ts.net
NEXTAUTH_URL=https://your-machine.your-tailnet.ts.net

# ---- NextAuth ----
# Generate one with: openssl rand -base64 32  (or any long random string)
NEXTAUTH_SECRET=change-me-to-a-long-random-secret

# ---- First administrator (created once by the seed step) ----
# Password must be at least 8 characters. You can log in with EITHER the email or
# the part before @ as the username.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me-to-a-strong-password
